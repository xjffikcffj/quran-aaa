<?xml version="1.0" encoding="utf-8"?>
<!--
   Explicit data extraction policy for Android 12+ (API >= 31).
   Using an explicit <include> allowlist ensures only non-personal app settings
   (Friday reminder toggle) are included, preventing unintended backup or transfer of:
   - Room database (bookmarks with personal notes, playback history, custom reciter URLs)
   - Player SharedPreferences (per-reciter listening positions, custom reciter JSON)
   - Downloaded MP3 files in files/quran_downloads
   - Third-party AdMob / UMP / WebView SDK SharedPreferences
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="quran_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="quran_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
